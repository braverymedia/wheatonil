  background: #E6E6E6;
  text-transform: uppercase;
  margin-bottom: 1rem;
}
@media (min-width: 64em) {
  .finder__show-all__btn,
.finder__compare__btn {
    margin-bottom: 0;
  }
}

.finder__show-all__btn {
  padding: 0.77rem 1rem;
  margin-right: 1rem;
}

.finder__compare__btn {
  position: absolute;
  left: -999rem;

  margin-top: 1.25rem;
  margin-bottom: 1.25rem;
}

.quote__slider {
  margin: 3rem 0;
}
.quote__slider .slick-dots {
  padding-left: 0;
  list-style: none;
  position: absolute;
  top: 0;
  left: 0;
}
.quote__slider .slick-arrow {
  display: none;
}

.quote__slide {
  margin: -1rem 3rem 0 0.7rem;
  text-align: center;
}

.rep-profile {

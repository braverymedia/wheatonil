}
@media (min-width: 32em) {
  .filter__col--2 {
    display: block;
  }
}

.filter__col--3 {
  display: none;
}
@media (min-width: 48em) {
  .filter__col--3 {
    display: block;
  }
}

.filter__col--4 {

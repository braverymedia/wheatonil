}

.filter__footer {
  margin: 5rem 0;
}
.filter__footer [data-message-empty] {
  display: none;
}
.filter__footer [data-reset] {
  display: none;
}
[data-empty] ~ .filter__footer [data-message-empty] {
  display: block;
}
[data-filtered] ~ .filter__footer [data-reset] {

body {
  line-height: var(--wc-line-height);
  font-family: var(--wc-font-family--sans-serif);
  overflow-x: hidden;
  color: var(--wc-color--grey-darkest2020);
}

h1, .h1,
h2, .h2,
h3, .h3, .stories__slide__content--title, .finder__filter__title,
h4, .h4,
h5, .h5,
h6, .h6 {
  font-family: var(--wc-font-family--display);
  margin-bottom: 1rem;
  font-weight: 400;
  letter-spacing: -0.02em;
  line-height: 1.05;
}

h1, h2, h3 {
  color: var(--wc-color--blue-dark);
}

h1,
.h1 {
  font-size: var(--wc-font-size--display-xl);
  font-weight: normal;
  line-height: 1;
}
@media (min-width: 32em) {
  h1,
.h1 {
    font-size: var(--wc-font-size--display-2xl);
  }
}
.headline h1,
.headline .h1 {
  margin: 0.6rem 0;
  color: var(--wc-color--blue-dark);
}

.headline + .share {
  margin-top: -2rem;
}

.headline--alt {
  margin-top: 2rem;
  border-bottom: 0.1rem solid rgba(30, 29, 29, 0.27);
}

h2,
.h2 {
  font-size: var(--wc-font-size--display-lg);
  font-weight: normal;
  /*  color: var(--wc-color--blue)-bright2020; */
}
@media (min-width: 32em) {
  h2,
.h2 {
    font-size: var(--wc-font-size--display-xl);
  }
}
@media (min-width: 48em) {
  .subnav__wrap h2,
.subnav__wrap .h2 {
    display: inline-block;
  }
}

h3,
.h3,
.stories__slide__content--title,
.finder__filter__title {
  font-size: var(--wc-font-size--display-md);
}

h4,
.h4 {
  color: var(--wc-color--blue-dark);
  font-family: var(--wc-font-family--san-serif);
  font-weight: 500;
  font-size: var(--wc-font-size--text-md);
}

a:not([class]) {
  color: var(--wc-color--blue-alt);
  text-decoration: underline;
}
a:not([class]):hover {
  text-decoration: none;
}

ul,
ol {
  margin-top: 1.25rem;
  margin-bottom: 1.25rem;
  padding-left: 2.5rem;
  font-size: var(--wc-font-size--text-regular);
}

li {
  margin-bottom: 0.75rem;
  font-size: var(--wc-font-size--text-regular);
}

p {
  margin-bottom: 2rem;
  font-size: var(--wc-font-size--text-lg);
}

.p--intro, .hero__finder__content__text {
  font-size: var(--wc-font-size--text-xl);
  line-height: 1.47;
  font-weight: bold;
}

.p--large, .social__message, .news__link {
  font-size: var(--wc-font-size--text-xl);
  line-height: 1.47;
}

.ul--plain {
  margin: 0;
  padding: 0;
  list-style: none;
}

hr {
  margin-top: 1.25rem;
  margin-bottom: 1.25rem;
  border-top: 0.2rem solid var(--wc-color--orange-2020);
}

.hr--blue {
  margin-top: 1.25rem;
  margin-bottom: 1.25rem;
  border-top: 0.2rem solid var(--wc-color--blue);
}

.hr--gray {
  margin-top: 1.25rem;
  margin-bottom: 1.25rem;
  border-top: 0.1rem solid rgba(var(--wc-color--black-light), 0.27);
}

.divider {
  margin: 1.5rem 8rem 0;
  background: var(--wc-color--white);
  height: 0.25rem;
}
.divider + .news {
  margin-top: 2rem;
}

.subtitle {
  font-size: var(--wc-font-size--text-lg);
  color: var(--wc-color--grey-dark);
  font-family: var(--wc-font-family--sans-serif);
  margin-top: -1rem;
  margin-bottom: 3rem;
}
.container--blue-dark .subtitle {
  color: var(--wc-color--white);
}

.tag {
  font-family: var(--wc-font-family--sans-serif-alt-bold);
  font-weight: normal;
  text-transform: uppercase;
  letter-spacing: 1px;
  font-size: var(--wc-font-size--text-xs);
}

.page {
  margin-top: 3rem;
}
@media (min-width: 64em) {
  .page {
    margin-top: 0;
  }
}
.home .page {
  margin-top: 0;
}
.menu-active .page {
  overflow: hidden;
}

.wrap, .subnav__list--wrap {
  max-width: 80rem;
  margin-right: auto;
  margin-left: auto;
  padding-right: 1rem;
  padding-left: 1rem;
}
.wrap::before, .subnav__list--wrap::before, .wrap::after, .subnav__list--wrap::after {
  content: "";
  display: table;
}
.wrap::after, .subnav__list--wrap::after {
  clear: both;
}
@media (min-width: 48em) {
  .wrap, .subnav__list--wrap {
    padding-right: 2rem;
    padding-left: 2rem;
  }
}
@media (min-width: 64em) {
  .wrap, .subnav__list--wrap {
    padding-right: 3rem;
    padding-left: 3rem;
  }
}

.wrap--wide {
  max-width: 96rem;
}

.wrap--narrow {
  max-width: 70rem;
}

.wrap--slim {
  max-width: 58rem;
}

.wrap--skinny {
  max-width: 48rem;
}

.wrap--relative {
  position: relative;
}

.main,
.sidebar {
  margin-top: 1.25rem;
  margin-bottom: 1.25rem;
}
@media (min-width: 64em) {
  .main,
.sidebar {
    margin-top: 5rem;
    margin-bottom: 5rem;
  }
}

.main {
  margin-top: 2.5rem;
  margin-bottom: 2.5rem;
}
@media (min-width: 64em) {
  .main {
    margin-top: 5rem;
    margin-bottom: 5rem;
    width: calc(100% - 22rem);
    float: right;
  }
  .main li {
    font-weight: normal;
  }
}
@media (min-width: 90em) {
  .main {
    width: calc(100% - 24rem);
  }
}

.main--group {
  margin-top: 2.5rem;
  margin-bottom: 2.5rem;
}
@media (min-width: 64em) {
  .main--group {
    margin-top: 5rem;
    margin-bottom: 5rem;
  }
}

@media (min-width: 64em) {
  .main--center {
    margin-right: auto;
    margin-left: auto;
    float: none;
  }
}

@media (min-width: 64em) {
  .sidebar {
    width: 18rem;
    float: left;
    clear: left;
  }
}
.sidebar:nth-child(2) {
  margin-top: 0;
}

@media (min-width: 64em) {
  .sidebar + .main + .sidebar {
    margin-top: -5rem;
  }
}

@media (min-width: 48em) {
  .main--spacing {
    margin-right: 4rem;
  }
}

.container--blue-dark {
  background: var(--wc-color--blue-dark);
  color: var(--wc-color--white);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
.container--blue-dark a {
  color: var(--wc-color--white);
}

.container--gray-lighter {
  background: #E6E6E6;
}

.section {
  padding: 2rem 0;
}

.section--bottom {
  padding-bottom: 1.25rem;
}

.section--large {
  padding: 4rem 0;
}

.align-left,
.align-right {
  margin-bottom: 1.25rem;
}
@media (min-width: 48em) {
  .align-left,
.align-right {
    max-width: 33.3333%;
  }
}

@media (min-width: 48em) {
  .align-left {
    margin-right: 1.25rem;
    float: left;
  }
}

@media (min-width: 48em) {
  .align-right {
    margin-left: 1.25rem;
    float: right;
  }
}

@media (min-width: 48em) {
  .align-small {
    max-width: 25%;
  }
}

@media (min-width: 48em) {
  .align-zero {
    margin-bottom: 0;
  }
}

.text-left {
  text-align: left;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.relative {
  position: relative;
}

.hide {
  position: absolute;
  left: -999rem;
}

.skip a {
  position: absolute;
  background: #E60000;
  left: -10000rem;
  top: -2rem;
  width: 0.1rem;
  height: 0.1rem;
  overflow: hidden;
  z-index: 100;
  color: #fff;
  outline: 0;
  padding: 0.5rem 1rem;
  font-size: 1rem;
  border-bottom-right-radius: 0.3rem;
  transition: top 1s ease-out;
}
.skip a:focus {
  left: 0;
  top: 0;
  width: auto;
  height: auto;
  transition: top 0.1s ease-in;
}

.mobile--hidden {
  position: absolute;
  left: -999rem;
}
@media (min-width: 64em) {
  .mobile--hidden {
    position: static;
    left: 0;
  }
}

.break:after {
  content: "\a";
  white-space: pre;
}
@media (min-width: 64em) {
  .break:after {
    content: "\a";
  }
}

.minimodal {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  width: 100%;
}

.minimodal__overlay {
  position: absolute;
  top: -8rem;
  left: 0;
  width: 100%;
  height: calc(100% + 16rem);
  background: rgba(0, 0, 0, 0.9);
}

.minimodal__viewport {
  position: relative;
  height: 100%;
  pointer-events: none;
}

.minimodal__item {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.minimodal__status {
  position: absolute;
  top: 50%;
  left: 50%;
  -ms-transform: translate(-50%, -50%);
  transform: translate(-50%, -50%);
  color: white;
  text-align: center;
}

.minimodal__content {
  height: 100%;
}

.minimodal__element {
  display: block;
  position: relative;
  top: 50%;
  max-width: 100%;
  max-height: 100%;
  margin: auto;
  -ms-transform: translateY(-50%);
  transform: translateY(-50%);
  pointer-events: auto;
}

.minimodal__element--map {
  background: white;
}

.minimodal__element--video {
  max-width: calc(100vh * (16/9));
}

.minimodal__element--video::before {
  display: block;
  padding-bottom: 56.25%;
  background: black;
  content: "";
}

.minimodal__video {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.minimodal__caption {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  color: white;
  pointer-events: auto;
}

.minimodal__close {
  position: absolute;
  top: 0;
  right: 0;
}

.minimodal__nav {
  position: absolute;
  top: 50%;
  -ms-transform: translateY(-50%);
  transform: translateY(-50%);
}

.minimodal__nav--previous {
  left: 0;
}

.minimodal__nav--next {
  right: 0;
}

/* customization */
.minimodal {
  transition: opacity 300ms ease;
  opacity: 0;
  z-index: 11;
}

.minimodal--active {
  opacity: 1;
}

.minimodal__overlay {
  background: rgba(0, 0, 0, 0.85);
}

.minimodal__content {
  max-width: 71.5rem;
  margin: 0 auto;
  padding-right: 2rem;
  padding-left: 2rem;
}

.minimodal--audio .minimodal__element iframe {
  width: 100%;
  height: 90px;
}

.minimodal__close {
  top: 2rem;
  right: 2rem;
  width: 3.5rem;
  height: 3.5rem;
  padding: 1.25rem;
  border: 0;
  border-radius: 50%;
  background: var(--wc-color--orange-2020);
  color: var(--wc-color--white);
}
.minimodal__close:hover {
  background: #7C868D;
}

.accordion {
  margin-top: 2.5rem;
  margin-bottom: 2.5rem;
}
.grid__item .accordion {
  margin-top: 0;
}

.accordion__toggle {
  padding: 1rem 0;
}

.accordion__content {
  padding: 0 0 1rem;
}

.accordion__toggle {
  display: block;
  width: 100%;
  text-align: left;
  border-bottom: 0.1rem solid rgba(var(--wc-color--black-light), 0.27);
  font-size: 1.375rem;
  font-family: var(--wc-font-family--sans-serif-alt-bold);
  font-weight: normal;
  color: var(--wc-color--blue-dark);
}
.container--blue-dark .accordion__toggle {
  border-color: rgba(var(--wc-color--white), 0.27);
  color: var(--wc-color--white);
}
.accordion__toggle:hover {
  text-decoration: none;
  color: var(--wc-color--blue-alt);
}
.container--blue-dark .accordion__toggle:hover {
  color: var(--wc-color--white);
}

.accordion__toggle-alt {
  display: block;
  width: 100%;
  text-align: left;
  border-bottom: 0.1rem solid rgba(var(--wc-color--black-light), 0.27);
  font-size: 1.375rem;
  font-family: var(--wc-font-family--serif);
  font-weight: bold;
  color: var(--wc-color--blue-dark);
}
.container--blue-dark .accordion__toggle-alt {
  border-color: rgba(var(--wc-color--white), 0.27);
  color: var(--wc-color--white);
}
.accordion__toggle-alt:hover {
  text-decoration: none;
  color: var(--wc-color--blue-alt);
}
.container--blue-dark .accordion__toggle-alt:hover {
  color: var(--wc-color--white);
}

.accordion__icon {
  width: 1.5rem;
  margin-right: 1.25rem;
  padding: 0.125rem;
  float: left;
  color: var(--wc-color--blue-alt);
}
.container--blue-dark .accordion__icon {
  color: var(--wc-color--orange);
}

.accordion__icon--inactive {
  display: block;
}
.accordion__toggle--active .accordion__icon--inactive {
  display: none;
}

.accordion__icon--active {
  display: none;
}
.accordion__toggle--active .accordion__icon--active {
  display: block;
}

.accordion__content {
  position: absolute;
  left: -999rem;
  visibility: hidden;
  border-bottom: 0.1rem solid rgba(var(--wc-color--black-light), 0.27);
}
.container--blue-dark .accordion__content {
  border-color: rgba(var(--wc-color--white), 0.27);
}

.accordion__toggle--active {
  border-bottom: 0;
}

.accordion__content--active {
  position: static;
  left: auto;
  visibility: visible;
}

.accordion__cta {
  margin-top: 1.25rem;
  margin-bottom: 1.25rem;
}

.alert {

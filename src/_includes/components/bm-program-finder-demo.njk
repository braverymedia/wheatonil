{# Mount Point for Vanilla JS Component #}
<div id="program-finder-mountpoint"
     aria-live="polite"
     aria-relevant="additions removals">
</div>

{# Trigger Button for Overlay Testing #}
<div style="margin: 2rem 0; text-align: center;">
    <button class="program-finder-trigger"
            data-widget="program-finder"
            aria-label="Find your program"
            aria-expanded="false"
            aria-controls="program-finder-mountpoint">
        <span class="trigger-text">Find your program</span>
        <svg class="trigger-icon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 1L15 8L8 15" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </button>
</div>

{# Include the vanilla JS module (CSS is included in main build) #}
<script src="/assets/js/modules/program-finder.js"></script>

{# Demo Instructions #}
<div style="margin: 2rem 0; padding: 1rem; background: #f5f5f5; border-radius: 4px;">
    <h3>Program Finder Demo</h3>
    <p><strong>Features to test:</strong></p>
    <ul>
        <li>✅ Fullscreen program finder with two-column layout</li>
        <li>✅ Filter by credential types (Bachelor, Certificate, Master, Doctoral)</li>
        <li>✅ Filter by areas of study (Humanities, Military, Education, etc.)</li>
        <li>✅ URL synchronization - filters are saved in URL parameters</li>
        <li>✅ Overlay mode - click the trigger button above</li>
        <li>✅ Responsive design - try different screen sizes</li>
        <li>✅ Accessibility - keyboard navigation and screen reader support</li>
        <li>✅ Animations - subtle transitions with reduced motion support</li>
    </ul>
    <p><strong>Sample data includes:</strong> 20 programs with various combinations of credential types, degree types, and areas of study.</p>
</div>
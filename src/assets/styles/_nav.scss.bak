// Main header styles
.main-header.bravery {
    background-color: var(--color--white);
    width: 100%;
    padding: var(--space--gap-medium);
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
    filter: drop-shadow(0px 1px 2px rgba(16, 24, 40, 0.05));
    gap: var(--space--gap-medium);
    position: sticky;
    top: 0;
    z-index: 10;

    .branding svg {
        height: 45px;
        width: auto;
    }

    @media (min-width: 1024px) {
        display: grid;
        grid-template-columns: 1fr 3fr 1fr;
        padding: 0 var(--space--gap-large);

        .branding svg {
            height: 72px;
        }
    }

    @media (min-width: 1300px) {
        padding: 0 var(--space--gap-xl);
    }

    &,
    .overlay-tools {
        width: 100%;
        height: 72px;
        color: var(--color--white);

        @media (min-width: 1024px) {
            height: 96px;
            border-top: 4px solid var(--color--blue-600);
        }
    }
}

.overlay-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space--gap-medium);

    @media (min-width: 1024px) {
        padding-block-start: 0;
        padding-block-end: 0;
    }
}

.main-header.style-graduate.bravery {
    background-color: var(--color--blue-900);

    .branding svg {
        height: 55px;
        width: auto;
    }

    @media (min-width: 1024px) {
        border-color: var(--color--cyan-500);

        .branding svg {
            height: 85px;
            width: auto;
        }
    }

    @media (min-width: 1300px) {
        .branding svg {
            height: 95px;
            width: auto;
        }
    }
}
.nav-actions,
.main-navigation {
    display: flex;
    align-items: center;
    gap: var(--space--gap-medium);
}

.main-navigation {
    order: 3;
    gap: var(--space--gap-large);
    font-family: var(--wc-font-family--serif);

    @media (min-width: 1024px) {
        order: 2;
        flex: 1 auto;
        justify-content: center;
    }

    .style-graduate & {
        font-family: var(--wc-font-family--sans-serif-alt-bold);
    }
}

.main-navigation>a {
    display: none;
}

.main-navigation>a,
.bravery button.menu-more,
.bravery button.search {
    background-color: transparent;
    padding: 10px 0;
    color: var(--color--blue-600);
    text-decoration: none;
    border: 2px solid transparent;
    font-size: var(--type-size--xsmall);
    border-radius: 0;
    font-family: inherit;

    &:hover {
        background: transparent;
        border-bottom-color: var(--color--orange-600);
        transition: all 200ms linear;
    }

    @media (min-width: 1024px) {
        display: flex;
        font-size: var(--type-size--medium);
    }

    .style-graduate & {
        font-family: var(--wc-font-family--sans-serif-alt-bold);
        color: inherit;
    }
}

.bravery.style-graduate button.menu-more,
.bravery.style-graduate button.search {
    color: inherit !important;
}

.nav-actions:is(.slate-nav),
.main-header:not(.slate-nav).main-navigation .menu-link {
    display: none;

    @media (min-width: 1024px) {
        display: inline-flex;
    }
}

.nav-actions {
    order: 2;
    flex: 1 auto;
    justify-content: flex-end;

    >.search,
    >.cta--visit {
        display: none;
    }

    @media (min-width: 1024px) {
        order: 3;
        display: flex;
        flex: 0 1 auto;

        >.search,
        >.cta--visit {
            display: flex;
        }
    }
}

.overlay-menu {
    background-color: var(--color--blue-600);
    color: var(--color--white);
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    height: 100vh;
    width: 100vw;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease-out, visibility 0s 0.4s;
    transform: translateY(-20px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    overflow: auto;
    will-change: transform, opacity;

    * {
        color: var(--color--white);
    }

    a {
        color: inherit !important;

        &.menu-link {
            padding: var(--space--gap-regular) 0;
            text-decoration: none;
            font-size: var(--type-size--xl);

            @media (min-width: 1024px) {
                font-size: var(--type-size--super);
            }

            &:hover {
                border-color: currentColor;
            }
        }
    }

    li {
        list-style: none;
        font-family: inherit;
        font-size: inherit;
    }

    @media (min-width: 1024px) {
        gap: 0 var(--space--gap-large);
        padding: 0 calc(var(--space--grid-unit) * 7);
        display: grid;
        align-items: start;
        grid-template-areas:
            'overlaytools overlaytools'
            'mainlinks    utilmenu';
        grid-template-columns: 10fr 2fr;
        grid-template-rows: 144px calc(100vh - 200px);
    }
}

.overlay-tools {
    background-color: var(--color--blue-600);
    display: grid;
    grid-template-columns: calc(100% - 40px) 40px;
    gap: 0 var(--space--gap-regular);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease-out 0.1s, transform 0.3s ease-out 0.1s;
    position: relative;
    z-index: 1;
    grid-area: overlaytools;
    width: 100%;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 5;

    form {
        grid-row: 1;
        display: flex;
        align-items: center;
        color: var(--color--white);
        padding: var(--space--gap-regular) var(--space--gap-medium);
        position: relative;

        &:before {
            background-color: var(--color--blue-dark);
            border-radius: 12px;
            content: "";
            width: 100%;
            height: 100%;
            position: absolute;
            left: 0;
            top: 0;
            z-index: -1;
        }

        *::placeholder {
            color: var(--color--blue-250);
        }

        @media (min-width: 1024px) {
            padding: var(--space--gap-medium) var(--space--gap-large);
        }
    }

    .close-menu {
        grid-row: 1;
        padding: 10px 5px;
        border: 0;

        &:hover {
            background-color: var(--color--blue-700);
        }
    }

    input {
        appearance: none;
        background: transparent;
        width: 100%;
        border: 0;
    }

    .bm--results-container {
        grid-row: 2;
        grid-column: 1 / span 2;
    }

    @media (min-width: 1024px) {
        align-content: center;
        position: relative;
        top: auto;
    }
}

.icon--search {
    height: 24px;
    width: 24px;
}

.visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
}

.bravery .bm--menu-links {
    padding: var(--space--gap-large) var(--space--gap-regular);
    
    .nav-menu {
        list-style: none;
        margin: 0;
        padding: 0;
        
        &__item {
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            
            &:last-child {
                border-bottom: none;
            }
        }
        
        &__header {
            display: flex;
            align-items: center;
            width: 100%;
        }
        
        &__link {
            flex: 1;
            display: block;
            padding: 1rem 0;
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            font-size: 1.1rem;
            transition: color 0.2s ease;
            
            &:hover, 
            &:focus {
                color: #f8f8f8;
                text-decoration: underline;
                outline: none;
            }
        }
        
        &__toggle {
            background: none;
            border: none;
            color: #fff;
            padding: 0.75rem;
            margin-right: -0.75rem;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            
            &:hover,
            &:focus {
                background-color: rgba(255, 255, 255, 0.1);
                outline: 2px solid rgba(255, 255, 255, 0.3);
                outline-offset: -2px;
            }
            
            .icon-plus {
                width: 24px;
                height: 24px;
                transition: transform 0.3s ease;
            }
            
            &[aria-expanded="true"] .icon-plus {
                transform: rotate(45deg);
            }
        }
    }
    
    .nav-submenu {
        list-style: none;
        margin: 0;
        padding: 0 0 0 1rem;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out;
        
        &__item {
            margin: 0.5rem 0;
            
            a {
                color: rgba(255, 255, 255, 0.9);
                text-decoration: none;
                font-size: 1rem;
                line-height: 1.4;
                display: block;
                padding: 0.5rem 0;
                
                &:hover,
                &:focus {
                    text-decoration: underline;
                    color: #fff;
                }
            }
        }
    }
        
        &__title {
            display: flex;
            align-items: center;
            margin: 0;
            padding: 0;
            width: 100%;
        }
        
        .accordion-link {
            flex: 1;
            display: block;
            padding: 1rem 0;
            color: #fff;
            text-decoration: none;
            font-weight: 600;
            font-size: 1.1rem;
            transition: color 0.2s ease;
            
            &:hover, 
            &:focus {
                color: #f8f8f8;
                text-decoration: underline;
                outline: none;
            }
        }
        
        .accordion-toggle {
            background: none;
            border: none;
            color: #fff;
            padding: 0.75rem;
            margin-right: -0.75rem;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            
            &:hover,
            &:focus {
                background-color: rgba(255, 255, 255, 0.1);
                outline: 2px solid rgba(255, 255, 255, 0.3);
                outline-offset: -2px;
            }
            
            .icon-plus {
                width: 24px;
                height: 24px;
                transition: transform 0.3s ease;
            }
            
            &[aria-expanded="true"] .icon-plus {
                transform: rotate(45deg);
            }
        }
    }

    h2 {
        margin-block-end: 0;
    }

    h2>button {
        appearance: none;
        background-color: transparent;
        border: 0;
        padding: 0 var(--space--gap-regular);
        width: 100%;
        display: flex;
        justify-content: space-between;
        color: inherit;
        font-size: inherit;
        font-family: inherit;
        text-align: left;

        svg {
            transform: rotate();
            transition: all 200ms ease-in-out;
        }
    }

    button:hover,
    button[aria-expanded="true"] {
        text-decoration: underline;
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;

        svg {
            transform: rotate(-45deg);
        }
    }

    ul {
        font-size: var(--type-size--regular);
        font-family: var(--wc-font-family--sans-serif);
        margin-block-start: 1rem;

        a {
            text-decoration: none;

            &:hover {
                text-decoration: underline;
            }
        }
    }

    .accordion-panel {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out;

        &.visible {
            display: block;
            height: auto;
            visibility: visible;
        }
    }

    button[aria-expanded=true]+ul {
        height: auto;
        visibility: visible;
    }

    @media (min-width: 1024px) {
        border-right: 1px solid var(--color--blue-800);
        display: grid;
        gap: var(--space--gap-medium) var(--space--gap-large);
        grid-template-columns: 3fr 4fr;
        align-items: start;
        padding-block-start: 0;
        padding-block-end: 0;

        button {
            cursor: auto;
        }

        button:hover,
        button[aria-expanded="true"] {
            text-decoration: underline;
            text-decoration-thickness: 4px;
            text-underline-offset: 16px;

            svg {
                transform: rotate(-45deg);
            }
        }

        h2 {
            font-size: var(--type-size--xl-fluid);
            grid-column: 1;
            grid-auto-flow: row;

            svg {
                display: none;
            }
        }

        h2>button {
            justify-content: start;
            white-space: ellipsis;
        }

        .accordion-panel {
            grid-column: 2;
            grid-row: 1 / span 6;
        }

        .accordion-panel {
            height: auto;
            visibility: hidden;
            opacity: 0;
            transition: all 200ms ease-in-out;

            &.visible {
                height: auto;
                opacity: 1;
                visibility: visible;
            }
        }
    }

    @media (min-width: 1400px) {
        ul {
            font-size: var(--type-size--medium);

            a {
                text-decoration: none;
            }
        }
    }

    @media (max-height: 900px) and (min-width: 1024px) and (max-width: 1440px) {
        padding-block-start: 0;
        gap: 0 var(--space--gap-large);
        grid-auto-rows: minmax(auto, 80px);

        h2 {
            font-size: var(--type-size--xl);
        }

        ul {
            font-size: var(--type-size--regular);
        }
    }
}

.bm--utility-menus {
    grid-area: utilmenu;
    font-size: var(--type-size--regular);
    padding: var(--space--gap-medium);
    display: flex;
    gap: var(--space--gap-medium);

    >* {
        flex: 0 1 50%;
    }

    h2 {
        font-family: var(--wc-font-family--sans-serif-alt-bold);
        color: var(--color--blue-300);
        font-size: inherit;
    }

    ul,
    li {
        padding: 0;
    }

    ul {
        margin-block-end: var(--space--gap-3xl);
    }

    li {
        margin-block-end: 0;
    }

    a {
        text-decoration: none;

        &:hover {
            text-decoration: underline;
        }
    }

    @media (min-width: 1024px) {
        padding: 0;
        display: block;
    }
}

.overlay-menu[data-state="hidden"] {
    transform: translateY(-20px);
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
    transition: transform 0.3s ease-out, opacity 0.2s ease-out, visibility 0s 0.3s;
}

.overlay-menu[data-state="visible"] {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease-out, visibility 0s;
    
    .overlay-tools {
        opacity: 1;
        transform: translateY(0);
    }
}

body.menu-open {
    overflow: hidden;
}
.bm--back-link {
    font-size: var(--type-size--small);
    display: inline-flex;
    gap: var(--space--gap-small);
    align-items: center;
    justify-content: flex-start;
    > svg {
        height: 16px;;
    }
}
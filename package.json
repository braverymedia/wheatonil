{
	"name": "wheaton2022",
	"version": "1.0.0",
	"description": "Website assets for Wheaton College in Illinois.",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"clean": "rm -rf _site dist",
		"clean:js": "rm -rf dist/assets/js",
		"clean:css": "rm -rf _site/assets/css",
		"clean:modules": "[ -d _site/assets/js/modules ] && find _site/assets/js/modules -name '*.min.js' -delete || true",
		"copy:modules": "mkdir -p _site/assets/js/modules && cp -r src/assets/js/modules/*.js _site/assets/js/modules/",
		"build:js": "npm run clean:js && NODE_ENV=production rollup -c && NODE_ENV=development rollup -c",
		"build:modules": "npm run copy:modules && npm run clean:modules && NODE_ENV=production rollup -c rollup.config.modules.mjs",
		"build:css": "NODE_ENV=production rollup -c rollup.config.styles.mjs",
		"build:eleventy": "ELEVENTY_ENV=production eleventy --config=eleventy.config.js",
		"watch:js": "NODE_ENV=development rollup -c --watch",
		"watch:modules": "npm run copy:modules && NODE_ENV=development rollup -c rollup.config.modules.mjs --watch",
		"watch:css": "NODE_ENV=development rollup -c rollup.config.styles.mjs --watch",
		"watch:eleventy": "ELEVENTY_ENV=development eleventy --serve --config=eleventy.config.js",
		"update:html": "node update-html.js",
		"test:modules": "node test-modules.js",
		"build": "run-s clean build:js build:eleventy build:modules build:css",
		"dev": "npm run build:css && run-p watch:js watch:modules watch:css watch:eleventy",
		"start": "npm run dev",
		"test": "npm run test:modules",
		"debug:start": "DEBUG=Eleventy* npm start",
		"debug:build": "DEBUG=Eleventy* npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/braverymedia/wheatonil.git"
	},
	"author": "Bravery Media",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/braverymedia/wheatonil/issues"
	},
	"homepage": "https://github.com/braverymedia/wheatonil#readme",
	"devDependencies": {
		"@11ty/eleventy": "^3.1.1",
		"@eslint/js": "^9.28.0",
		"@rollup/plugin-commonjs": "^28.0.3",
		"@rollup/plugin-node-resolve": "^15.3.1",
		"@rollup/plugin-terser": "^0.4.3",
		"autoprefixer": "^10.4.21",
		"browserslist": "^4.21.10",
		"clean-css": "^5.3.2",
		"cross-env": "^7.0.3",
		"cssnano": "^6.1.2",
		"eslint": "^9.28.0",
		"glob": "^11.0.3",
		"globals": "^16.2.0",
		"jsdom": "^26.1.0",
		"lightningcss": "^1.21.5",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.4",
		"postcss-cli": "^10.1.0",
		"postcss-preset-env": "^10.2.1",
		"purgecss": "^5.0.0",
		"rollup": "^3.29.5",
		"rollup-plugin-postcss": "^4.0.2",
		"rollup-plugin-svelte": "^7.1.6",
		"sass": "^1.65.1",
		"terser": "^5.19.2"
	},
	"dependencies": {
		"a11y-dialog": "^8.0.0",
		"html-minifier": "^4.0.0",
		"oembed": "^0.1.2",
		"oembed-parser": "^3.1.5",
		"svelte": "^4.2.0",
		"uglify-es": "^3.3.9"
	}
}

{
	"name": "wheaton2022",
	"version": "1.0.0",
	"description": "Website assets for Wheaton College in Illinois.",
	"main": "index.js",
	"scripts": {
		"sass": "sass src/_includes/assets/scss:src/_includes/assets/css",
		"postcss": "postcss _site/assets/css/*.css --use autoprefixer cssnano --no-map --replace",
		"build:sass": "npm-run-all --sequential sass",
		"watch:sass": "sass --watch src/_includes/assets/scss:src/_includes/assets/css",
		"build:js": "rollup -c",
		"watch:js": "rollup -c --watch",
		"build:eleventy": "ELEVENTY_ENV=production eleventy",
		"watch:eleventy": "ELEVENTY_ENV=development eleventy --serve",
		"start": "cross-env NODE_ENV=development npm-run-all build:sass --sequential postcss build:js --parallel watch:*",
		"debug:start": "DEBUG=Eleventy* npm start",
		"build": "cross-env NODE_ENV=production npm-run-all build:sass --sequential --style=compressed build:js --parallel build:eleventy postcss",
		"debug:build": "DEBUG=Eleventy* npm run build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/braverymedia/wheatonil.git"
	},
	"author": "Bravery Media",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/braverymedia/wheatonil/issues"
	},
	"homepage": "https://github.com/braverymedia/wheatonil#readme",
	"devDependencies": {
		"@11ty/eleventy": "^2.0.0",
		"@rollup/plugin-node-resolve": "^15.0.1",
		"@rollup/plugin-terser": "^0.4.0",
		"autoprefixer": "^10.4.13",
		"clean-css": "^5.3.2",
		"cross-env": "^7.0.3",
		"cssnano": "^5.1.15",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.21",
		"postcss-cli": "^10.1.0",
		"purgecss": "^5.0.0",
		"rollup": "^3.18.0",
		"sass": "^1.58.3",
		"terser": "^5.16.5"
	},
	"dependencies": {
		"html-minifier": "^4.0.0",
		"oembed": "^0.1.2",
		"oembed-parser": "^3.1.5",
		"uglify-es": "^3.3.9"
	}
}

{
	"name": "wheaton2022",
	"version": "1.0.0",
	"description": "Website assets for Wheaton College in Illinois.",
	"main": "index.js",
	"scripts": {
		"postcss": "postcss _site/assets/css/*.css --use autoprefixer cssnano --no-map --replace",
		"build:sass": "sass src/_includes/assets/scss:src/_includes/assets/css",
		"build-compressed:sass": "sass --style=compressed src/_includes/assets/scss:src/_includes/assets/css",
		"watch:sass": "sass --watch src/_includes/assets/scss:src/_includes/assets/css",
		"build:js": "rollup -c",
		"watch:js": "rollup -c --watch",
		"build:eleventy": "ELEVENTY_ENV=production eleventy",
		"build:eleventy-dev": "ELEVENTY_ENV=development eleventy",
		"watch:eleventy": "ELEVENTY_ENV=development eleventy --serve",
		"start": "cross-env NODE_ENV=development npm-run-all build:eleventy-dev build:js --parallel watch:*",
		"debug:start": "DEBUG=Eleventy* npm start",
		"build": "cross-env NODE_ENV=production npm-run-all build:js --parallel build:eleventy",
		"debug:build": "DEBUG=Eleventy* npm run build",
		"dev": "npm-run-all start"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/braverymedia/wheatonil.git"
	},
	"author": "Bravery Media",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/braverymedia/wheatonil/issues"
	},
	"homepage": "https://github.com/braverymedia/wheatonil#readme",
	"devDependencies": {
		"@11ty/eleventy": "^2.0.1",
		"@rollup/plugin-node-resolve": "^15.1.0",
		"@rollup/plugin-terser": "^0.4.3",
		"autoprefixer": "^10.4.15",
		"browserslist": "^4.21.10",
		"clean-css": "^5.3.2",
		"cross-env": "^7.0.3",
		"cssnano": "^6.0.1",
		"lightningcss": "^1.21.5",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.27",
		"postcss-cli": "^10.1.0",
		"purgecss": "^5.0.0",
		"rollup": "^3.28.0",
		"rollup-plugin-svelte": "^7.1.6",
		"sass": "^1.65.1",
		"terser": "^5.19.2"
	},
	"dependencies": {
		"html-minifier": "^4.0.0",
		"oembed": "^0.1.2",
		"oembed-parser": "^3.1.5",
		"svelte": "^4.2.0",
		"uglify-es": "^3.3.9"
	}
}
